#version 450


#include "AVBD-header.glsl"

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

vec4 conjugate(vec4 q) {
	return vec4( -q.x, -q.y, -q.z, q.w );
}

vec4 inverse(vec4 q) {
	return conjugate(q) / dot(q, q);
}


vec4 quatTime(vec4 a, vec4 b) {
	return vec4(
		a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
		a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
		a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
		a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z );
}



vec3 subAng(vec4 a, vec4 b) {
	return quatTime(a, inverse(b)).xyz * 2.0f;
}

void main() {
	uint id = gl_GlobalInvocationID.x;

	if (id >= rigidbodyCount) {
		return;
	}
    if (rigids[id].sleeping != 0) { atomicAdd(sleepingCount,1); return; }

 if (colors[id] < 0 && rigids[id].isStatic == 0) atomicOr(errors, 2u);
 if (any(isnan(rigids[id].positionLin)) || any(isinf(rigids[id].positionLin)) || any(isnan(rigids[id].positionAng)) || any(isinf(rigids[id].positionAng))) atomicOr(errors, 4u);
	rigids[id].prevVelocityLin = rigids[id].velocityLin;
	if (rigids[id].isStatic == 0) {
		rigids[id].velocityLin = (rigids[id].positionLin - rigids[id].initialLin) / dt;
		rigids[id].velocityAng = subAng(rigids[id].positionAng,rigids[id].initialAng) / dt;
	}
    // Conservative sleep: no dynamic neighbors, multiple support contacts,
    // converged gaps and force balance, and two seconds of negligible motion.
    // Contacts and multipliers are retained unchanged until a dynamic AABB wakes us.
    if (sleepEnabled != 0 && rigids[id].isStatic == 0) {
        bool quiet = length(rigids[id].velocityLin) < 0.002 && length(rigids[id].velocityAng) < 0.002;
        vec3 support = vec3(0); uint contacts = 0;
        for (int slot = rigids[id].listHead; slot >= 0; slot = nextContact(slot,id)) {
            uint other = manifolds[slot].force.bodyA == id ? manifolds[slot].force.bodyB : manifolds[slot].force.bodyA;
            if (rigids[other].isStatic == 0) { quiet = false; break; }
            for (uint k = 0; k < manifolds[slot].numContacts; ++k) {
                Contact c = manifolds[slot].contacts[k];
                quiet = quiet && abs(c.C0.x) < 0.0005;
                support -= manifolds[slot].basis*c.lambda;
                ++contacts;
            }
        }
        vec3 residual = support + vec3(0,rigids[id].mass*gravity,0);
        quiet = quiet && contacts >= 3 && length(residual) < 0.01*rigids[id].mass*abs(gravity);
        rigids[id].quietSteps = quiet ? rigids[id].quietSteps+1 : 0;
        if (rigids[id].quietSteps >= 120) {
            rigids[id].sleeping = 1;
            rigids[id].velocityLin = vec3(0); rigids[id].velocityAng = vec3(0); rigids[id].prevVelocityLin = vec3(0);
            atomicAdd(sleepingCount,1);
        }
    }
   

}
