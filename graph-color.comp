#version 450
#include "AVBD-header.glsl"
layout(local_size_x = 128) in;
void main() {
 uint id = gl_GlobalInvocationID.x;
 if (id >= rigidbodyCount || rigids[id].isStatic != 0 || colors[id] >= 0) return;
 uint weight = priority(id); uint occupied = 0;
 for (int slot = rigids[id].listHead; slot >= 0; slot = nextContact(slot, id)) {
  uint other = manifolds[slot].force.bodyA == id ? manifolds[slot].force.bodyB : manifolds[slot].force.bodyA;
  if (rigids[other].isStatic != 0) continue;
  int c = atomicAdd(colors[other], 0);
  // Treat writes from this dispatch as uncolored, independent of scheduling.
  if (c < 0 || c / 32 == color + 1) {
   uint w = priority(other);
   if (w < weight || (w == weight && other < id)) return;
  } else occupied |= 1u << (c & 31);
 }
 int chosen = findLSB(~occupied);
 if (chosen < 0) { atomicOr(errors, 2u); return; }
 atomicExchange(colors[id], (color + 1) * 32 + chosen);
 uint offset = atomicAdd(colorCounts[chosen], 1);
 colors[rigidbodyCount * (1 + chosen) + offset] = int(id);
 atomicMax(dispatches[chosen * 3], offset / 128 + 1);
}
