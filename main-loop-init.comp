void updatePrimal(uint manifoldIndex, uint body, float alpha, inout mat3 lhsLin, inout mat3 lhsAng, inout mat3 lhsCross, inout vec3 rhsLin, inout vec3 rhsAng)
{
	vec3 dqALin = rigids[manifolds[manifoldIndex].force.bodyA].positionLin - rigids[manifolds[manifoldIndex].force.bodyA].initialLin;
	vec3 dqAAng = AngDiff(rigids[manifolds[manifoldIndex].force.bodyA].positionAng, rigids[manifolds[manifoldIndex].force.bodyA].initialAng);
	vec3 dqBLin = rigids[manifolds[manifoldIndex].force.bodyB].positionLin - rigids[manifolds[manifoldIndex].force.bodyB].initialLin;
	vec3 dqBAng = AngDiff(rigids[manifolds[manifoldIndex].force.bodyB].positionAng, rigids[manifolds[manifoldIndex].force.bodyB].initialAng);

	for (int i = 0; i < manifolds[manifoldIndex].numContacts; i++)
	{
		vec3 rAWorld = rotate(rigids[manifolds[manifoldIndex].force.bodyA].positionAng, manifolds[manifoldIndex].contacts[i].rA);
		vec3 rBWorld = rotate(rigids[manifolds[manifoldIndex].force.bodyB].positionAng, manifolds[manifoldIndex].contacts[i].rB);

		mat3 jALin = manifolds[manifoldIndex].basis;
		mat3 jBLin = -manifolds[manifoldIndex].basis;
		// HERE
		mat3 jAAng = transpose(mat3(cross(rAWorld, jALin[0]), cross(rAWorld, jALin[1]), cross(rAWorld, jALin[2])));
		mat3 jBAng = transpose(mat3(cross(rBWorld, jBLin[0]), cross(rBWorld, jBLin[1]), cross(rBWorld, jBLin[2])));

		mat3 K = mat3(
			vec3(manifolds[manifoldIndex].contacts[i].penalty.x, 0.0, 0.0),
			vec3(0.0, manifolds[manifoldIndex].contacts[i].penalty.y, 0.0),
			vec3(0.0, 0.0, manifolds[manifoldIndex].contacts[i].penalty.z)
		);
		vec3 C = manifolds[manifoldIndex].contacts[i].C0 * (1 - alpha) + jALin * dqALin + jBLin * dqBLin + jAAng * dqAAng + jBAng * dqBAng;

		vec3 F = K * C + manifolds[manifoldIndex].contacts[i].lambda;

		F.x = min(F.x, 0.0f);

		float bounds = abs(F.x) * manifolds[manifoldIndex].friction;
		float frictionScale = length(vec2(F.y, F.z));
		if (frictionScale > bounds && frictionScale > 0)
		{
			F.y *= bounds / frictionScale;
			F.z *= bounds / frictionScale;
		}

		mat3 jLin = body == manifolds[manifoldIndex].force.bodyA ? jALin : jBLin;
		mat3 jAng = body == manifolds[manifoldIndex].force.bodyA ? jAAng : jBAng;

		mat3 jLinT = transpose(jLin);
		mat3 jAngT = transpose(jAng);
		mat3 jAngTk = jAngT * K;

		lhsLin += jLinT * K * jLin;
		lhsAng += jAngTk * jAng;
		lhsCross += jAngTk * jLin;
		
		rhsLin += jLinT * F;
		rhsAng += jAngT * F;
	}
}

uint hash_weight(uint x) {
	x = ((x >> 16) ^ x) * 0x45d9f3b;
    x = ((x >> 16) ^ x) * 0x45d9f3b;
    x = (x >> 16) ^ x;
    return x;
}

void graph_color(uint id, int listHead) {
	uint weight = hash_weight(id);
	bool is_local_max = true;

	int cur = listHead;
	while (cur != -1) {
		uint bodyBId = manifolds[cur].force.bodyB;
		uint otherWeight = hash_weight(bodyBId);
		if (otherWeight > weight || (otherWeight == weight && bodyBId > id)) {
			is_local_max = false;
			break;
		}
		cur = manifolds[cur].force.next;
	}

	if (is_local_max) {		
        uint occupied_mask = 0;

		int cur = listHead;
		while (cur != -1) {
			uint color = colors[manifolds[cur].force.bodyB];
			if (color < 32) {
				occupied_mask |= (1u << color);
			}
			cur = manifolds[cur].force.next;
		}
        
        colors[id] = int(findLSB(~occupied_mask));
	}


}



void updateDual(uint manifoldIndex, float alpha)
{
	vec3 dqALin = rigids[manifolds[manifoldIndex].force.bodyA].positionLin - rigids[manifolds[manifoldIndex].force.bodyA].initialLin;
	vec3 dqAAng = AngDiff(rigids[manifolds[manifoldIndex].force.bodyA].positionAng, rigids[manifolds[manifoldIndex].force.bodyA].initialAng);
	vec3 dqBLin = rigids[manifolds[manifoldIndex].force.bodyB].positionLin - rigids[manifolds[manifoldIndex].force.bodyB].initialLin;
	vec3 dqBAng = AngDiff(rigids[manifolds[manifoldIndex].force.bodyB].positionAng, rigids[manifolds[manifoldIndex].force.bodyB].initialAng);

	for (int i = 0; i < manifolds[manifoldIndex].numContacts; i++) {
		vec3 rAWorld = rotate(rigids[manifolds[manifoldIndex].force.bodyA].positionAng, manifolds[manifoldIndex].contacts[i].rA);
		vec3 rBWorld = rotate(rigids[manifolds[manifoldIndex].force.bodyB].positionAng, manifolds[manifoldIndex].contacts[i].rB);

		mat3 jALin = manifolds[manifoldIndex].basis;
		mat3 jBLin = -manifolds[manifoldIndex].basis;
		mat3 jAAng = transpose(mat3(cross(rAWorld, jALin[0]), cross(rAWorld, jALin[1]), cross(rAWorld, jALin[2])));
		mat3 jBAng = transpose(mat3(cross(rBWorld, jBLin[0]), cross(rBWorld, jBLin[1]), cross(rBWorld, jBLin[2])));

		
		mat3 K = mat3(
			vec3(manifolds[manifoldIndex].contacts[i].penalty.x, 0.0, 0.0),
			vec3(0.0, manifolds[manifoldIndex].contacts[i].penalty.y, 0.0),
			vec3(0.0, 0.0, manifolds[manifoldIndex].contacts[i].penalty.z)
		);
		vec3 C = manifolds[manifoldIndex].contacts[i].C0 * (1 - alpha) + jALin * dqALin + jBLin * dqBLin + jAAng * dqAAng + jBAng * dqBAng;

		vec3 F = K * C + manifolds[manifoldIndex].contacts[i].lambda;

		F.x = min(F.x, 0.0f);

		float bounds = abs(F.x) * manifolds[manifoldIndex].friction;
		float frictionScale = length(vec2( F.y, F.z ));
		if (frictionScale > bounds && frictionScale > 0) {
			F.y *= bounds / frictionScale;
			F.z *= bounds / frictionScale;
		}

		manifolds[manifoldIndex].contacts[i].lambda = F;

		if (F.x < 0)
			manifolds[manifoldIndex].contacts[i].penalty[0] = min(manifolds[manifoldIndex].contacts[i].penalty[0] + betaLin * abs(C.x), PENALTY_MAX);
		if (frictionScale <= bounds) {
			manifolds[manifoldIndex].contacts[i].penalty[1] = min(manifolds[manifoldIndex].contacts[i].penalty[1] + betaLin * abs(C.y), PENALTY_MAX);
			manifolds[manifoldIndex].contacts[i].penalty[2] = min(manifolds[manifoldIndex].contacts[i].penalty[2] + betaLin * abs(C.z), PENALTY_MAX);
			manifolds[manifoldIndex].contacts[i].stick = length(vec2(C.y, C.z)) < STICK_THRESH;
		}
	}
}


vec4 quatTime(vec4 a, vec4 b) {
	return vec4(
		a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
		a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
		a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
		a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z );
}



vec4 addAng(vec4 a, vec3 b) {
	return normalize(a + quatTime(vec4( b.x, b.y, b.z, 0 ), a) * 0.5f);
}

vec3 subAng(vec4 a, vec4 b) {
	return quatTime(a, inverse(b)).xyz * 2.0f;
}


void main() {
	uint id = gl_GlobalInvocationID.x;
	
	if (id < rigidbodyCount) {
		//if (id == 0)
		//	debugPrintfEXT("position = %f %f %f isStatic%d\n", rigids[id].positionLin.x, rigids[id].positionLin.y, rigids[id].positionLin.z, rigids[id].isStatic);
		rigids[id].inertialLin = rigids[id].positionLin + rigids[id].velocityLin * dt;
		if (rigids[id].isStatic == 0) {
			rigids[id].inertialLin += vec3(0.0, gravity, 0.0) * (dt * dt);
		}
		rigids[id].inertialAng = addAng(rigids[id].positionAng, rigids[id].velocityAng * dt);

		vec3 accel = (rigids[id].velocityLin - rigids[id].prevVelocityLin) / dt;
		
		float accelExt = accel.y * sign(gravity);

		float accelWeight = clamp(accelExt / abs(gravity), 0.0, 1.0);
	
		if (isinf(accelWeight) || isnan(accelWeight)) {
			accelWeight = 0.0;
		}
	
		rigids[id].initialLin = rigids[id].positionLin;
		rigids[id].initialAng = rigids[id].positionAng;

		if (rigids[id].isStatic == 0) {
		
			rigids[id].positionLin = rigids[id].positionLin + rigids[id].velocityLin * dt + vec3(0.0, gravity, 0.0) * (accelWeight * dt * dt);
			rigids[id].positionAng = addAng(rigids[id].positionAng, rigids[id].velocityAng * dt);
		}
	}

	if (id == 0) {
		debugPrintfEXT("main-loop-init positionAng = %f, %f, %f\n", rigids[0].positionAng.x, rigids[0].positionAng.y, rigids[0].positionAng.z);
		
	}

    

}
