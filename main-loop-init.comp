#version 450
#extension GL_EXT_debug_printf : enable

#include "AVBD-header.glsl"
layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;

vec3 rotate(vec4 angle, vec3 v) {
	vec3 u = vec3( angle.x, angle.y, angle.z );
	vec3 t = cross(u, v) * 2.0f;
	return v + t * angle.w + cross(u, t);
}

OBB makeOBB(uint body) {
	OBB box;
	box.center = rigids[body].positionLin;
	box.rotation = rigids[body].positionAng;
	box.halfExtent = rigids[body].size * 0.5f;
	box.axis[0] = rotate(rigids[body].positionAng, vec3( 1.0f, 0.0f, 0.0f ));
	box.axis[1] = rotate(rigids[body].positionAng, vec3( 0.0f, 1.0f, 0.0f ));
	box.axis[2] = rotate(rigids[body].positionAng, vec3( 0.0f, 0.0f, 1.0f ));
	return box;
}

vec4 conjugate(vec4 q) {
	return vec4( -q.x, -q.y, -q.z, q.w );
}

mat3 orthonormal(vec3 normal) {
	vec3 t1 = abs(normal.x) > abs(normal.z) ? vec3( -normal.y, normal.x, 0 ) : vec3( 0, -normal.z, normal.y );
	t1 = normalize(t1);
	vec3 t2 = cross(normal, t1);
	return transpose(mat3( normal, t1, t2 ));
}


bool addContact(uint bodyA, uint bodyB, out Contact contacts[8], inout uint contactCount, out vec3 contactMidpoints[8], vec3 xA, vec3 xB, uint feature) {
		vec3 midpoint = (xA + xB) * 0.5f;

		for (int i = 0; i < contactCount; ++i) {
			vec3 d = midpoint - contactMidpoints[i];
			if (dot(d, d) < CONTACT_MERGE_DIST_SQ)
				return false;
		}

		if (contactCount >= MAX_CONTACTS)
			return false;
				
		contacts[contactCount].feature = feature;
		contacts[contactCount].rA = rotate(conjugate(rigids[bodyA].positionAng), xA - rigids[bodyA].positionLin);
		contacts[contactCount].rB = rotate(conjugate(rigids[bodyB].positionAng), xB - rigids[bodyB].positionLin);
		contacts[contactCount].stick = false;
		contacts[contactCount].lambda = vec3(0);
		contacts[contactCount].penalty = vec3(0);
		contactMidpoints[contactCount] = midpoint;
		++contactCount;

		return true;
	}

bool testAxis(OBB boxA, OBB boxB, vec3 delta, vec3 axis, uint type, int indexA, int indexB, out SatAxis best) {
		float lenSq = dot(axis, axis);
		if (lenSq < SAT_AXIS_EPSILON)
			return true;

		float invLen = 1.0f / sqrt(lenSq);
		vec3 n = axis * invLen;
		if (dot(n, delta) < 0.0f)
			n = -n;

		float distance = abs(dot(delta, n));

		float rA =
			boxA.halfExtent.x * abs(dot(n, boxA.axis[0])) +
			boxA.halfExtent.y * abs(dot(n, boxA.axis[1])) +
			boxA.halfExtent.z * abs(dot(n, boxA.axis[2]));

		float rB =
			boxB.halfExtent.x * abs(dot(n, boxB.axis[0])) +
			boxB.halfExtent.y * abs(dot(n, boxB.axis[1])) +
			boxB.halfExtent.z * abs(dot(n, boxB.axis[2]));

		float separation = distance - (rA + rB);
		if (separation > 0.0f)
			return false;

		if (!best.valid || separation > best.separation) {
			best.valid = true;
			best.type = type;
			best.indexA = indexA;
			best.indexB = indexB;
			best.separation = separation;
			best.normalAB = n;
		}

		return true;
}

void supportEdge(OBB box, int axisIndex, vec3 dir, out vec3 edgeA, out vec3 edgeB) {
		int axis1 = (axisIndex + 1) % 3;
		int axis2 = (axisIndex + 2) % 3;

		float sign1 = dot(dir, box.axis[axis1]) >= 0.0f ? 1.0f : -1.0f;
		float sign2 = dot(dir, box.axis[axis2]) >= 0.0f ? 1.0f : -1.0f;

		vec3 edgeCenter = box.center
			+ box.axis[axis1] * (box.halfExtent[axis1] * sign1)
			+ box.axis[axis2] * (box.halfExtent[axis2] * sign2);

		edgeA = edgeCenter - box.axis[axisIndex] * box.halfExtent[axisIndex];
		edgeB = edgeCenter + box.axis[axisIndex] * box.halfExtent[axisIndex];
}

void closestPointsOnSegments(vec3 p0, vec3 p1, vec3 q0, vec3 q1, out vec3 c0, out vec3 c1) {
		vec3 d1 = p1 - p0;
		vec3 d2 = q1 - q0;
		vec3 r = p0 - q0;
		float a = dot(d1, d1);
		float e = dot(d2, d2);
		float f = dot(d2, r);

		float s = 0.0f;
		float t = 0.0f;

		if (a <= SAT_AXIS_EPSILON && e <= SAT_AXIS_EPSILON) {
			c0 = p0;
			c1 = q0;
			return;
		}

		if (a <= SAT_AXIS_EPSILON) {
			t = clamp(f / e, 0.0f, 1.0f);
		}
		else {
			float c = dot(d1, r);
			if (e <= SAT_AXIS_EPSILON) {
				s = clamp(-c / a, 0.0f, 1.0f);
			}
			else {
				float b = dot(d1, d2);
				float denom = a * e - b * b;

				if (abs(denom) > SAT_AXIS_EPSILON)
					s = clamp((b * f - c * e) / denom, 0.0f, 1.0f);

				t = (b * s + f) / e;

				if (t < 0.0f) {
					t = 0.0f;
					s = clamp(-c / a, 0.0f, 1.0f);
				}
				else if (t > 1.0f) {
					t = 1.0f;
					s = clamp((b - c) / a, 0.0f, 1.0f);
				}
			}
		}

		c0 = p0 + d1 * s;
		c1 = q0 + d2 * t;
}


vec3 supportPoint(OBB box, vec3 dir) {
		float sx = dot(dir, box.axis[0]) >= 0.0f ? 1.0f : -1.0f;
		float sy = dot(dir, box.axis[1]) >= 0.0f ? 1.0f : -1.0f;
		float sz = dot(dir, box.axis[2]) >= 0.0f ? 1.0f : -1.0f;

		return box.center
			+ box.axis[0] * (box.halfExtent.x * sx)
			+ box.axis[1] * (box.halfExtent.y * sy)
			+ box.axis[2] * (box.halfExtent.z * sz);
	}

void getFaceAxes(OBB box, int axisIndex, out vec3 u, out vec3 v, out float extentU, out float extentV) {
		int uaxis = (axisIndex + 1) % 3;
		int vaxis = (axisIndex + 2) % 3;
		u = box.axis[uaxis];
		v = box.axis[vaxis];
		extentU = box.halfExtent[uaxis];
		extentV = box.halfExtent[vaxis];

	}

void buildFaceFrame(OBB box, int axisIndex, vec3 outwardNormal, out FaceFrame frame) {
		float sign = dot(outwardNormal, box.axis[axisIndex]) >= 0.0f ? 1.0f : -1.0f;
		frame.axisIndex = axisIndex;
		frame.normal = box.axis[axisIndex] * sign;
		frame.center = box.center + frame.normal * box.halfExtent[axisIndex];
		getFaceAxes(box, axisIndex, frame.u, frame.v, frame.extentU, frame.extentV);
	}



uint buildEdgeContact(uint bodyA, uint bodyB, OBB boxA, OBB boxB, int axisA, int axisB, vec3 normalAB, out Contact contacts[8]) {
		vec3 a0, a1, b0, b1;
		supportEdge(boxA, axisA, normalAB, a0, a1);
		supportEdge(boxB, axisB, -normalAB, b0, b1);

		vec3 xA, xB;
		closestPointsOnSegments(a0, a1, b0, b1, xA, xB);

		uint contactCount = 0;
		vec3 contactMidpoints[8];
		uint featureKey = (AXIS_EDGE << 24) | ((axisA & 0xFF) << 8) | (axisB & 0xFF);
		addContact(bodyA, bodyB, contacts, contactCount, contactMidpoints, xA, xB, featureKey);

		if (contactCount == 0) {
			xA = supportPoint(boxA, normalAB);
			xB = supportPoint(boxB, -normalAB);
			addContact(bodyA, bodyB, contacts, contactCount, contactMidpoints, xA, xB, featureKey);
		}

		return contactCount;
	}

int clipPolygonAgainstPlane(vec3 inVerts[MAX_POLY_VERTS], int inCount, vec3 planeNormal, float planeOffset, out vec3 outVerts[MAX_POLY_VERTS]) {
		if (inCount <= 0)
			return 0;

		int outCount = 0;
		vec3 a = inVerts[inCount - 1];
		float da = dot(planeNormal, a) - planeOffset;

		for (int i = 0; i < inCount; ++i) {
			vec3 b = inVerts[i];
			float db = dot(planeNormal, b) - planeOffset;
			bool aInside = da <= PLANE_EPSILON;
			bool bInside = db <= PLANE_EPSILON;

			if (aInside != bInside) {
				float t = 0.0f;
				float denom = da - db;
				if (abs(denom) > SAT_AXIS_EPSILON)
					t = clamp(da / denom, 0.0f, 1.0f);

				if (outCount < MAX_POLY_VERTS)
					outVerts[outCount++] = a + (b - a) * t;
			}
			
			if (bInside && outCount < MAX_POLY_VERTS)
				outVerts[outCount++] = b;

			a = b;
			da = db;
		}

		return outCount;
	}

int chooseIncidentFaceAxis(OBB box, vec3 referenceNormal) {
		int axis = 0;
		float best = -FLT_MAX;

		for (int i = 0; i < 3; ++i) {
			float d = abs(dot(box.axis[i], referenceNormal));
			if (d > best) {
				best = d;
				axis = i;
			}
		}

		return axis;
	}

void buildIncidentFace(OBB box, int axisIndex, vec3 referenceNormal, out vec3 outVerts[MAX_POLY_VERTS]) {
		float sign = dot(box.axis[axisIndex], referenceNormal) > 0.0f ? -1.0f : 1.0f;
		vec3 faceNormal = box.axis[axisIndex] * sign;
		vec3 faceCenter = box.center + faceNormal * box.halfExtent[axisIndex];

		vec3 u;
		vec3 v;
		float extentU;
		float extentV;
		getFaceAxes(box, axisIndex, u, v, extentU, extentV);

		outVerts[0] = faceCenter + u * extentU + v * extentV;
		outVerts[1] = faceCenter - u * extentU + v * extentV;
		outVerts[2] = faceCenter - u * extentU - v * extentV;
		outVerts[3] = faceCenter + u * extentU - v * extentV;
	}


uint buildFaceManifold(uint bodyA, uint bodyB, OBB boxA, OBB boxB, bool referenceIsA, int referenceAxis, vec3 normalAB, out Contact contacts[8])
	{
		const OBB referenceBox = referenceIsA ? boxA : boxB;
		const OBB incidentBox = referenceIsA ? boxB : boxA;
		vec3 referenceOutward = referenceIsA ? normalAB : -normalAB;

		FaceFrame referenceFace;
		buildFaceFrame(referenceBox, referenceAxis, referenceOutward, referenceFace);

		int incidentAxis = chooseIncidentFaceAxis(incidentBox, referenceFace.normal);

		vec3 clip0[MAX_POLY_VERTS];
		vec3 clip1[MAX_POLY_VERTS];
		buildIncidentFace(incidentBox, incidentAxis, referenceFace.normal, clip0);
		int count = 4;

		vec3 n0 = referenceFace.u;
		float o0 = dot(n0, referenceFace.center) + referenceFace.extentU;
		count = clipPolygonAgainstPlane(clip0, count, n0, o0, clip1);
		if (count == 0)
			return 0;

		vec3 n1 = -referenceFace.u;
		float o1 = dot(n1, referenceFace.center) + referenceFace.extentU;
		count = clipPolygonAgainstPlane(clip1, count, n1, o1, clip0);
		if (count == 0)
			return 0;

		vec3 n2 = referenceFace.v;
		float o2 = dot(n2, referenceFace.center) + referenceFace.extentV;
		count = clipPolygonAgainstPlane(clip0, count, n2, o2, clip1);
		if (count == 0)
			return 0;

		vec3 n3 = -referenceFace.v;
		float o3 = dot(n3, referenceFace.center) + referenceFace.extentV;
		count = clipPolygonAgainstPlane(clip1, count, n3, o3, clip0);
		if (count == 0)
			return 0;

		uint contactCount = 0;
		vec3 contactMidpoints[MAX_CONTACTS];
		uint featurePrefix = (referenceIsA ? AXIS_FACE_A : AXIS_FACE_B) << 24;
		featurePrefix |= (referenceAxis & 0xFF) << 16;
		featurePrefix |= (incidentAxis & 0xFF) << 8;

		for (int i = 0; i < count && contactCount < MAX_CONTACTS; ++i) {
			vec3 pIncident = clip0[i];
			float distance = dot(pIncident - referenceFace.center, referenceFace.normal);
			if (distance > PLANE_EPSILON)
				continue;

			vec3 pReference = pIncident - referenceFace.normal * distance;
			vec3 xA = referenceIsA ? pReference : pIncident;
			vec3 xB = referenceIsA ? pIncident : pReference;

			addContact(bodyA, bodyB, contacts, contactCount, contactMidpoints, xA, xB, featurePrefix | (i & 0xFF));
		}

		if (contactCount == 0) {
			vec3 xA = supportPoint(boxA, normalAB);
			vec3 xB = supportPoint(boxB, -normalAB);
			addContact(bodyA, bodyB, contacts, contactCount, contactMidpoints, xA, xB, featurePrefix);
		}

		return contactCount;
	}


uint boxBoxCollide(uint bodyA, uint bodyB, out Contact contacts[8], out mat3 basisOut) {
    OBB boxA = makeOBB(bodyA);
	OBB boxB = makeOBB(bodyB);
	vec3 delta = boxB.center - boxA.center;

	SatAxis bestFace;
	bestFace.separation = -FLT_MAX;
	bestFace.valid = false;

	SatAxis bestEdge;
	bestEdge.separation = -FLT_MAX;
	bestEdge.valid = false;

	for (int i = 0; i < 3; ++i) {
		if (!testAxis(boxA, boxB, delta, boxA.axis[i], AXIS_FACE_A, i, -1, bestFace))
			return 0;
	}

	for (int i = 0; i < 3; ++i) {
		if (!testAxis(boxA, boxB, delta, boxB.axis[i], AXIS_FACE_B, -1, i, bestFace))
			return 0;
	}

	for (int i = 0; i < 3; ++i) {
		for (int j = 0; j < 3; ++j)
		{
			vec3 axis = cross(boxA.axis[i], boxB.axis[j]);
			if (!testAxis(boxA, boxB, delta, axis, AXIS_EDGE, i, j, bestEdge))
				return 0;
		}
	}

	if (!bestFace.valid)
		return 0;

	SatAxis best = bestFace;
	if (bestEdge.valid) {
		const float edgeRelTol = 0.95f;
		const float edgeAbsTol = 0.01f;
		if (edgeRelTol * bestEdge.separation > bestFace.separation + edgeAbsTol)
			best = bestEdge;
	}

	basisOut = orthonormal(-best.normalAB);

	if (best.type == AXIS_EDGE)
		return buildEdgeContact(bodyA, bodyB, boxA, boxB, best.indexA, best.indexB, best.normalAB, contacts);

	if (best.type == AXIS_FACE_A)
		return buildFaceManifold(bodyA, bodyB, boxA, boxB, true, best.indexA, best.normalAB, contacts);

	return buildFaceManifold(bodyA, bodyB, boxA, boxB, false, best.indexB, best.normalAB, contacts);
}

uint sphereSphereCollide(uint bodyA, uint bodyB, out Contact contacts[8], out mat3 basisOut) {
	vec3 delta = rigids[bodyB].positionLin - rigids[bodyA].positionLin;
	float rSum = rigids[bodyA].radius + rigids[bodyB].radius;
	float distSq = dot(delta, delta);
	if (distSq > rSum * rSum)
		return 0;
	if (distSq < SAT_AXIS_EPSILON)
		return 0;
	float dist = length(delta);
	vec3 normal = delta / dist;

	vec3 pointOnA = rigids[bodyA].positionLin + normal * rigids[bodyA].radius;
	vec3 pointOnB = rigids[bodyB].positionLin - normal * rigids[bodyB].radius;
	vec3 contactMidpoints[MAX_CONTACTS];
	uint numContacts = 0;
	uint featureKey = AXIS_SPHERE << 24;
	addContact(bodyA, bodyB, contacts, numContacts, contactMidpoints, pointOnA, pointOnB, featureKey);
	basisOut = orthonormal(-normal);
	return numContacts;
}

uint sphereBoxCollide(uint bodyA, uint bodyB, bool bodyAIsSphere, out Contact contacts[8], out mat3 basisOut) {
	OBB box = makeOBB(bodyAIsSphere ? bodyB : bodyA);

	vec3 sphereCenter = bodyAIsSphere ? rigids[bodyA].positionLin : rigids[bodyB].positionLin;
	float radius = bodyAIsSphere ? rigids[bodyA].radius : rigids[bodyB].radius;

	vec3 delta = sphereCenter - box.center;

	vec3 closestPoint = box.center;

	for (int i = 0; i < 3; i++) {
		float dist = dot(delta, box.axis[i]);
		float clamped = clamp(dist, -box.halfExtent[i], box.halfExtent[i]);
		closestPoint += box.axis[i] * clamped;
	}

	vec3 dir = closestPoint - sphereCenter;

	float distSq = dot(dir, dir);

	if (distSq > radius * radius)
		return 0;

	vec3 normal;
	float penetration;

	if (distSq > SAT_AXIS_EPSILON) {
		float dist = length(dir);
		normal = dir / dist;
		penetration = radius - dist;
	}
	else {
		float minPen = FLT_MAX;
		vec3 bestAxis = vec3(0.0);

		for (int i = 0; i < 3; i++) {
			float d = dot(delta, box.axis[i]);
			float pen = box.halfExtent[i] - abs(d);

			if (pen < minPen) {
				minPen = pen;
				bestAxis = box.axis[i] * (d > 0.0f ? 1.0f : -1.0f);
			}
		}

		normal = bestAxis;
		penetration = radius + minPen;
	}

	vec3 pointOnSphere = sphereCenter + normal * radius;
	vec3 pointOnBox = closestPoint;

	uint numContacts = 0;
	uint featureKey = (AXIS_CLOSEST << 24);
	featureKey |= (bodyAIsSphere ? 0 : 1) << 16;
	vec3 contactMidpoints[MAX_CONTACTS];

	if (bodyAIsSphere) {
		addContact(bodyA, bodyB, contacts, numContacts, contactMidpoints, pointOnSphere, pointOnBox, featureKey);
	}
	else {
		addContact(bodyA, bodyB, contacts, numContacts, contactMidpoints, pointOnBox, pointOnSphere, featureKey);
	}


	basisOut = orthonormal(bodyAIsSphere ? -normal : normal);

	return numContacts;
}

uint collide(uint bodyA, uint bodyB, out Contact contacts[8], out mat3 basisOut)
{
	uint shapeA = rigids[bodyA].shape;
    uint shapeB = rigids[bodyB].shape;
    
    uint typeKey = (shapeA << 1) | shapeB;

    switch (typeKey) {
        case 0: // SPHERE-SPHERE (00)
            return sphereSphereCollide(bodyA, bodyB, contacts, basisOut);
        
        case 1: // SPHERE-BOX (01)
            return sphereBoxCollide(bodyA, bodyB, true, contacts, basisOut);
        
        case 2: // BOX-SPHERE (10)            
            return sphereBoxCollide(bodyB, bodyA, false, contacts, basisOut);
        
        case 3: // BOX-BOX (11)
            return boxBoxCollide(bodyA, bodyB, contacts, basisOut);
        
        default:
            return 0;
    }
}


vec3 transform(vec3 qLin, vec4 qAng, vec3 v) {
	return rotate(qAng, v) + qLin;
}

bool initialize(uint index) {    
    manifolds[index].friction = sqrt(rigids[manifolds[index].force.bodyA].friction * rigids[manifolds[index].force.bodyB].friction);
	
	Contact newContacts[8];

	uint newNumContacts = collide(manifolds[index].force.bodyA, manifolds[index].force.bodyB, newContacts, manifolds[index].basis);
	
	for (int i = 0; i < newNumContacts; i++)
	{
		for (int j = 0; j < manifolds[index].numContacts; j++)
		{
			if (newContacts[i].feature == manifolds[index].contacts[j].feature)
			{
				vec3 newRA = newContacts[i].rA;
				vec3 newRB = newContacts[i].rB;
				newContacts[i] = manifolds[index].contacts[j];

				if (!manifolds[index].contacts[j].stick)
				{
					newContacts[i].rA = newRA;
					newContacts[i].rB = newRB;
				}
				break;
			}
		}
	}

	manifolds[index].numContacts = newNumContacts;
	for (int i = 0; i < manifolds[index].numContacts; i++)
		manifolds[index].contacts[i] = newContacts[i];

	for (int i = 0; i < manifolds[index].numContacts; i++) {
		vec3 xA = transform(rigids[manifolds[index].force.bodyA].positionLin, rigids[manifolds[index].force.bodyA].positionAng, manifolds[index].contacts[i].rA);
		vec3 xB = transform(rigids[manifolds[index].force.bodyB].positionLin, rigids[manifolds[index].force.bodyB].positionAng, manifolds[index].contacts[i].rB);
		manifolds[index].contacts[i].C0 = manifolds[index].basis * (xA - xB) + vec3( COLLISION_MARGIN, 0, 0 );

		manifolds[index].contacts[i].lambda = manifolds[index].contacts[i].lambda * alpha * gamma;
		manifolds[index].contacts[i].penalty = clamp(manifolds[index].contacts[i].penalty * gamma, PENALTY_MIN, PENALTY_MAX);
	}

	return manifolds[index].numContacts > 0;
}

vec4 inverse(vec4 q) {
	return conjugate(q) / dot(q, q);
}
vec4 qmul(vec4 a, vec4 b) {
    return vec4(
        a.w*b.xyz + b.w*a.xyz + cross(a.xyz, b.xyz),
        a.w*b.w - dot(a.xyz, b.xyz)
    );
}

vec3 AngDiff(vec4 a, vec4 b) {
    return qmul(a, inverse(b)).xyz * 2.0f;
}

